{
  "name": "whatsapp-electron",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.local.whatsapp",
    "productName": "WhatsApp",
    "electronVersion": "39.5.2",
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Network"
    }
  },
  "devDependencies": {
    "electron-builder": "^25.0.0"
  }
}
